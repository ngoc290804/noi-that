# Copy to .env and fill in the Neon credentials. Never put these in the FE.
DB_URL=jdbc:postgresql://YOUR-ENDPOINT-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channelBinding=require&prepareThreshold=0
DB_USERNAME=neondb_owner
DB_PASSWORD=replace-me
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
# A separate private bearer token for the admin media API (at least 32 random characters).
MEDIA_UPLOAD_TOKEN=replace-with-a-long-random-token
