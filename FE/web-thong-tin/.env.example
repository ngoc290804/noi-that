# Base URL public; chỉ chứa URL, không đặt token/DB/Cloudinary secret trong VITE_*.
# Dev/preview proxy /api tới BE. Khi deploy dùng reverse proxy hoặc URL HTTPS của API.
VITE_API_BASE_URL=/api
# Chỉ dùng bởi Vite dev/preview, không đưa vào bundle trình duyệt.
API_PROXY_TARGET=http://127.0.0.1:8080
